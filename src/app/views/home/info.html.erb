<div class="app-container-normal">
  <header class="mb-10">
    <h2 class="app-h2">お知らせ</h2>
    <p class="mt-2 text-sm text-slate-500">
      記事(全 <%= @result[:total] %> 件)
    </p>
  </header>

  <% if @result[:posts].empty? %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center text-slate-500">
      表示できる記事がありません。
    </div>
  <% else %>
    <div class="space-y-8">
      <% @result[:posts].each do |post| %>
        <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
          <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-white px-6 py-5">
            <div class="inline-flex items-center rounded-full bg-indigo-100 px-3 py-1 text-xs font-medium text-indigo-700">
              <%= Time.zone.parse(post["date"]).strftime("%Y/%m/%d") %>
            </div>
            <h3 class="mt-3 text-xl font-semibold leading-snug text-slate-900 sm:text-2xl hover:underline">
              <%= link_to sanitize(post["title"]["rendered"], tags: []), home_info_detail_path(id: post["id"]) %>
            </h3>
          </div>

          <div class="prose prose-slate max-w-none px-6 py-6 prose-a:text-indigo-600 prose-img:rounded-xl">
            <%= sanitize(post["excerpt"]["rendered"]) %>
          </div>
        </article>
      <% end %>
    </div>

    <nav class="mt-10 flex items-center justify-between">
      <% if @page > 1 %>
        <%= link_to "← 前へ", home_info_path(page: @page - 1),
              class: "rounded-full border border-slate-300 bg-white px-5 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50" %>
      <% else %>
        <span class="rounded-full border border-slate-200 px-5 py-2 text-sm text-slate-300">← 前へ</span>
      <% end %>

      <span class="text-sm text-slate-500">
        <span class="font-semibold text-slate-900"><%= @page %></span> / <%= @result[:total_pages] %>
      </span>

      <% if @page < @result[:total_pages] %>
        <%= link_to "次へ →", home_info_path(page: @page + 1),
              class: "rounded-full bg-indigo-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-indigo-500" %>
      <% else %>
        <span class="rounded-full border border-slate-200 px-5 py-2 text-sm text-slate-300">次へ →</span>
      <% end %>
    </nav>
  <% end %>
</div>