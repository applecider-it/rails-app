<div class="app-container-normal">
  <header class="mb-10">
    <h2 class="app-h2"><%= sanitize(@post["title"]["rendered"], tags: []) %></h2>

    <p><%= link_to "お知らせ一覧に戻る", home_info_path, class: "app-link-normal" %></p>
  </header>

  <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
    <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-white px-6 py-5">
      <div class="inline-flex items-center rounded-full bg-indigo-100 px-3 py-1 text-xs font-medium text-indigo-700">
        <%= Time.zone.parse(@post["date"]).strftime("%Y/%m/%d") %>
      </div>
    </div>

    <div class="prose prose-slate max-w-none px-6 py-6 prose-a:text-indigo-600 prose-img:rounded-xl">
      <%= sanitize(@post["content"]["rendered"]) %>
    </div>
  </article>
</div>