<div class="space-y-3 my-10">
  <%- if controller_name != 'sessions' %>
    <div><%= link_to "ログイン", new_session_path(resource_name), class: "app-link-normal" %></div>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <div><%= link_to "パスワードをお忘れですか？", new_password_path(resource_name), class: "app-link-normal" %></div>
  <% end %>
</div>
