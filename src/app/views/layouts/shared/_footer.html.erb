<%
link_style = "hover:text-gray-300 transition-colors text-sm text-gray-400"
%>
<footer class="bg-gray-100 text-gray-300 border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- ブランド名・ひとこと -->
      <div class="text-center md:text-left">
        <a href="/" class="text-lg font-bold bg-linear-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">
          MySite
        </a>
        <p class="text-xs text-gray-400 mt-1">
          日常の記録やチャットを楽しめるスペース
        </p>
      </div>

      <!-- リンク -->
      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <%= link_to 'Top', root_path, class: link_style %>
        <%= link_to 'Tweet', tweets_path, class: link_style %>
        <%= link_to 'Chat', chat_index_path, class: link_style %>
        <%= link_to 'お知らせ', info_path, class: link_style %>
        <%= link_to 'ブログ', posts_path, class: link_style %>
      </nav>
    </div>

    <div class="mt-6 pt-6 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-500">
      <p>&copy; <%= Time.current.year %> MySite. All rights reserved.</p>
      <p>Built with Ruby on Rails &amp; Tailwind CSS</p>
    </div>
  </div>
</footer>