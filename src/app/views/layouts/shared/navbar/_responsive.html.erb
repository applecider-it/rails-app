<%
link_style = "block py-2 text-gray-700 hover:text-indigo-500"
%>
<!-- Mobile Menu -->
<div class="md:hidden">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/">
      <div
        class="text-xl font-bold bg-linear-to-r from-indigo-500 to-purple-500 bg-clip-text text-transparent"
      >
        MySite
      </div>
    </a>

    <!-- Mobile Button -->
    <button @click="open = !open" class="text-2xl cursor-pointer">
      ☰
    </button>
  </div>

  <div
    x-show="open"
    x-transition.duration.200ms
    class="px-6 pb-4"
    style="display: none;"
  >
    <%= link_to 'Top', root_path, class: link_style %>
    <%= link_to 'Tweet', tweets_path, class: link_style %>
    <%= link_to 'Tweet(JS)', tweets_js_path, class: link_style %>
    <%= link_to 'Chat', chat_index_path, class: link_style %>
    <%= link_to 'Chat(P)', chat_pusher_index_path, class: link_style %>
    <%= link_to 'お知らせ', info_path, class: link_style %>
    <%= link_to 'ブログ', posts_path, class: link_style %>

    <% if user_signed_in? %>
        <%= link_to current_user.name, edit_user_registration_path, class: link_style %>
        <%= button_to 'Logout',
          destroy_user_session_path,
          method: :delete,
          class: link_style,
          onclick: "return confirm('ログアウトしますか？');" %>
    <% else %>
        <%= link_to 'Login', new_user_session_path, class: link_style %>
        <%= link_to 'Sign up', new_user_registration_path, class: link_style %>
    <% end %>
  </div>
</div>
