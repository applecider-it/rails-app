<% breadcrumbs.tap do |links| %>
  <% if links.any? %>
    <div class="text-sm mx-4 mt-5">
      <% links.each_with_index do |link, index| %>
        <% if index != 0 %>
          <span class="px-1">></span>
        <% end %>
        <% if link.current? %>
          <%= link.text %>
        <% else %>
          <%= link_to link.text, link.url, class: "app-link-normal" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>