<script type="module">
  const dropZone = document.getElementById('drop-zone');
  const target = document.getElementById('attachment');
  const fileInfo = document.getElementById('dd-info');
  const dragoverClass = "bg-gray-300";

  window.App.funcs.setupFileDragAndDrop(dropZone, target, fileInfo, dragoverClass);
</script>

<%= form_with url: development_upload_test_path, method: :post, multipart: true do |form| %>
  <div id="drop-zone" class="border-2 border-dashed bg-gray-100 border-gray-400 p-6 rounded-lg text-gray-400 cursor-pointer">
    ここにファイルをドラッグ＆ドロップしてください
  </div>
  <div id="dd-info"></div>

  <div class="mt-5 border">
    実際に利用するときは、ここは非表示にする。
    <%= form.file_field :attachment %>
  </div>

  <div class="mt-5">
    <%= form.submit "アップロード", class: "app-btn-primary" %>
  </div>
<% end %>