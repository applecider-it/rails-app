<div class="space-y-5">
  <div>サーバーから送信された部品</div>
  <div>ページ: 「<%= page %>」</div>
  <div>検索文字列: 「<%= search %>」</div>
  <div>カテゴリー: 「<%= category %>」</div>
  <div class="space-x-3">
    改ページ例：
    <form
      <%= tag.attributes(
        "hx-post": development_htmx_post_path,
        "hx-target": "#htmx_result",
        "hx-swap": "innerHTML",
      ) %>
    >
      <%= hidden_field_tag :search, search %>
      <%= hidden_field_tag :category, category %>

      <div class="space-x-3">
        <%= button_tag "前のページ", name: "page", value: page - 1, class: "app-btn-secondary" %>
        <%= button_tag "次のページ", name: "page", value: page + 1, class: "app-btn-secondary" %>
        <span class="hidden in-[.htmx-request]:inline-block">送信中...</span>
      </div>
    </form>
  </div>
</div>