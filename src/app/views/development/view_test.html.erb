<%
  copy_value = "コピーする文字列\n<span>コピーする文字列</span>\n"
%>
<div class="app-container-normal">
  <h3 class="app-h3">読み込み中表示の動作確認</h3>
  <div class="mt-5 border-gray-500 border-2 p-0">
    <%= render 'shared/message/loading' %>
  </div>
  <div class="mt-5 border-gray-500 border-2 p-0">
    <%= render 'shared/message/loading' %>
  </div>

  <h3 class="app-h3 mt-10">フォームの動作確認</h3>

  <%= render "form" %>

  <h3 class="app-h3 mt-10">郵便番号検索</h3>

  <%= render "address_form" %>

  <h3 class="app-h3 mt-10">ドラッグアンドドロップ</h3>

  <%= render "drag_and_drop" %>

  <h3 class="app-h3 mt-10">コピーの動作確認</h3>

  <div class="mt-5">
    <button type="button" onclick="App.funcs.writeClipboard(this.dataset.val, this)" data-val="<%= copy_value %>" class="app-btn-primary">Copy</button>

    <div>
      <textarea class="app-form-input w-full h-20 mt-2"></textarea>
    </div>
  </div>

  <h3 class="app-h3 mt-10">Tailwindの動作確認</h3>

  <div class="mt-5 border-2 p-10 space-y-5">
    <div>
      <div class="app-development-tailwind-test">
        <span class="hidden in-[.app-development-tailwind-test]:block">表示される</span>
      </div>
      <div>
        <span class="hidden in-[.app-development-tailwind-test]:block">表示されない</span>
      </div>
    </div>
    <div>
      <div class="app-pwa:hidden">
        pwaでは非表示
      </div>
      <div class="hidden app-pwa:block">
        pwaだけ表示される
      </div>
    </div>
  </div>
  
  <script type="module">
    console.log('モジュールスコープ動作確認')
    const val1 = 123;
    console.log(typeof val1);
  </script>
  <script type="module">
    console.log(typeof val1);
  </script>
</div>
