<%
  copy_value = "コピーする文字列\n<span>コピーする文字列</span>\n"
  block_style = 'border-gray-400 border-2 p-4 rounded-lg'
%>
<div class="app-container-normal">
  <div class="space-y-7">
    <div class="<%= block_style %>">
      <h3 class="app-h3">読み込み中表示の動作確認</h3>
      <div class="mt-5 border-gray-500 border-2 p-0">
        <%= render 'shared/message/loading' %>
      </div>
      <div class="mt-5 border-gray-500 border-2 p-0">
        <%= render 'shared/message/loading' %>
      </div>
    </div>

    <div class="<%= block_style %>">
      <h3 class="app-h3">フォームの動作確認</h3>

      <%= render "form" %>
    </div>

    <div class="<%= block_style %>">
      <h3 class="app-h3">郵便番号検索</h3>

      <%= render "address_form" %>
    </div>

    <div class="<%= block_style %>">
      <h3 class="app-h3">ドラッグアンドドロップ</h3>

      <%= render "drag_and_drop" %>
    </div>

    <div class="<%= block_style %>">
      <h3 class="app-h3">コピーの動作確認</h3>

      <div class="mt-5">
        <button type="button" onclick="App.funcs.writeClipboard(this.dataset.val, this)" data-val="<%= copy_value %>" class="app-btn-primary">Copy</button>

        <div>
          <textarea class="app-form-input w-full h-20 mt-2"></textarea>
        </div>
      </div>
    </div>

    <div class="<%= block_style %>">
      <h3 class="app-h3">Tailwindの動作確認</h3>

      <%= render "tailwind" %>
    </div>
  </div>

  <script type="module">
    console.log('モジュールスコープ動作確認')
    const val1 = 123;
    console.log(typeof val1);
  </script>
  <script type="module">
    console.log(typeof val1);
  </script>
</div>
