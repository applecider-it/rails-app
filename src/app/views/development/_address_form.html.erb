<script type="module">
  const btnEl = document.getElementById('search_postal_code');
  const postalCodeEl = document.getElementById('postal_code');
  const prefectureEl = document.getElementById('prefecture');
  const cityEl = document.getElementById('city');
  const addressLine1El = document.getElementById('address_line1');

  window.App.funcs.setupPostalCodeSearch(btnEl, postalCodeEl, prefectureEl, cityEl, addressLine1El);
</script>

<%= form_with do |form| %>
  <div class="space-y-3">
    <div>
      <%= form.label :postal_code, class: "block" %>
      <div class="flex items-center gap-2">
        <div>
          <%= form.text_field :postal_code, class: "app-form-input w-32" %>
        </div>

        <div>
          <button type="button" class="app-btn-secondary" id="search_postal_code">郵便番号検索</button>
        </div>
      </div>
    </div>

    <div>
      <%= form.label :prefecture, class: "block" %>
      <%= form.select :prefecture, DataServices::FixeddataService.prefectures.invert, { include_blank: "選択してください" }, class: "app-form-input w-64" %>
    </div>

    <div>
      <%= form.label :city, class: "block" %>
      <%= form.text_field :city, class: "app-form-input" %>
    </div>

    <div>
      <%= form.label :address_line1, class: "block" %>
      <%= form.text_field :address_line1, class: "app-form-input" %>
    </div>
  </div>
<% end %>
