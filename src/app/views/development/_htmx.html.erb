<% 
htmx_categories = {
  1 => "カテゴリーA",
  2 => "カテゴリーB",
  3 => "カテゴリーC",
}

category = nil
#category = 3

search = nil
#search = "テスト"
%>

<div class="border-4 p-10 space-y-5">
  <form
    <%= tag.attributes(
      "hx-post": development_htmx_post_path,
      "hx-target": "#htmx_result",
      "hx-swap": "innerHTML",
      "hx-disabled-elt": "find input, find select, find button",
      "hx-on::before-request": "console.log('送信開始！');window.App.funcs.setIsLoading(true);",
      "hx-on::after-request": "console.log('送信終了！');window.App.funcs.setIsLoading(false);",
      class: "flex gap-3 flex-wrap",
    ) %>
  >
    <%= select_tag :category, options_for_select([["選択してください", ""]] + htmx_categories.map { |k, v| [v, k] }, category) %>

    <%= text_field_tag :search, search, placeholder: "検索キーワードを入力...", class: "app-form-input w-auto" %>

    <%= button_tag type: "submit", class: "app-btn-primary" do %>
      <span class="in-[.htmx-request]:hidden">検索</span>
      <span class="hidden in-[.htmx-request]:inline-block">検索中...</span>
    <% end %>
  </form>
  
  <!-- 結果表示エリア -->
  <div id="htmx_result" class="border-2 p-5">初期テキスト</div>
</div>
