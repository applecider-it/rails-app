<div class="app-container-normal">
  <%= form_with url: development_richtext_editor_test_path, method: :post do |f| %>
    <div data-val="<%= @content %>" id="editor">
      <%= render 'shared/message/loading' %>
    </div>

    <script type="module">
      const editor = document.getElementById('editor');

      window.App.funcs.setupRichtextEditor(
        editor,
        editor.dataset.val,
        (val) => {
          console.log('結果', val);
          document.getElementById('trace').innerHTML = val;
          document.getElementById('content_preview').value = val;
          document.getElementById('content').value = val;
        }
      )
    </script>

    <div class="my-5">結果：</div>
    <div id="trace" class="mt-4 p-5 border-4 prose prose-slate max-w-none h-100 overflow-y-auto"><%= app_sanitize_richtext @content %></div>
    
    <div>
      <textarea id="content_preview" class="w-full h-100"><%= @content %></textarea>
    </div>

    <%= hidden_field_tag :content, @content %>

    <%= submit_tag "送信", class: "app-btn-primary" %>
  <% end %>

  <div class="my-5">初期状態：</div>
  <div class="mt-4 p-5 border-4 prose prose-slate max-w-none h-100 overflow-y-auto"><%= app_sanitize_richtext @content %></div>
</div>
