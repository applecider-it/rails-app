<div class="app-container-normal">
  <div data-val="<%= @val %>" id="editor">
    <%= render 'shared/message/loading' %>
  </div>

  <script type="module">
    const editor = document.getElementById('editor');

    window.App.funcs.setupEditor(
      editor,
      editor.dataset.val,
      (val) => {
        console.log('結果', val);
        document.getElementById('trace').innerHTML = val;
        document.getElementById('output').value = val;
      }
    )
  </script>

  <div class="my-5">結果：</div>
  <div id="trace" class="mt-4 p-5 border-4 prose prose-slate max-w-none h-100 overflow-y-auto"><%= raw @val %></div>
  <textarea id="output" class="w-full h-100"><%= @val %></textarea>
</div>
